#!name=NodeLoc 签到
#!desc=NodeLoc 每日签到领能量（Discourse 论坛），查看奖励与能量余额。账号、密码和签到时间在模块「编辑参数」里设置。
#!author=Muse
#!icon=https://www.nodeloc.com/favicon.ico
#!arguments=username,password,checkin_hour:9,checkin_minute:0
#!arguments-desc=username：NodeLoc 用户名或邮箱；password：NodeLoc 密码（密码里有 & 请写 %26，有 = 请写 %3D）；checkin_hour：每天签到小时（0-23，默认 9）；checkin_minute：每天签到分钟（0-59，默认 0）。开了两步验证的账号无法用本模块登录。

[Script]
NodeLoc签到 = type=cron,cronexp="{{{checkin_minute}}} {{{checkin_hour}}} * * *",timeout=60,script-path=https://raw.githubusercontent.com/JiuYueQingCheng/nodeloc-surge-checkin/main/nodeloc.js,argument=username={{{username}}}&password={{{password}}}

[MITM]
hostname = %APPEND% www.nodeloc.com
